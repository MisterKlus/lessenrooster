<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Easter eggs: verjaardag, of "nachtuil" als je de app tussen middernacht en 5 uur opent -->
            <TextView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/owl_bg"
                android:padding="14dp"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Easter egg: 7 keer tikken zet het geheime blauwdruk-thema aan of uit -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_name"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/intro"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <!-- Voorbeeld: precies dezelfde opmaak als de widget, met je echte volgende les -->
            <FrameLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="20dp" />

            <!-- Alleen zichtbaar als er een nieuwere versie van de app op GitHub staat -->
            <Button
                android:id="@+id/update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent"
                android:minHeight="52dp"
                android:text="@string/update"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent"
                android:minHeight="52dp"
                android:text="@string/pin"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/open"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/help"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- Easter egg: ver onder het einde, alleen te vinden als je blijft doorscrollen -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="1600dp" />

            <TextView
                android:id="@+id/secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/secret_title"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/secret_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/secret_text"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/secret_sign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:text="@string/secret_sign"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Easter egg: schudden met de gsm -->
    <LinearLayout
        android:id="@+id/gears_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <io.github.misterklus.lessenrooster.GearsView
            android:id="@+id/gears"
            android:layout_width="match_parent"
            android:layout_height="240dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gears_title"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gears_hint"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Easter egg: confetti op Thomas' verjaardag (vangt geen tikken op) -->
    <io.github.misterklus.lessenrooster.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
