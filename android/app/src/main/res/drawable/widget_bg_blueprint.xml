<?xml version="1.0" encoding="utf-8"?>
<!-- Geheim thema "blauwdruk": technisch blauw met een gestippelde rand, zoals een bouwtekening -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1D4E89" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#99B9D3F5"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
</shape>
